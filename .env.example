# Pagina temporanea "Banca ore — La Terra dei Bambini" (/terra-dei-bambini).
# Da rimuovere insieme alla pagina a raccolta adesioni conclusa.

# Postgres. Su Vercel viene iniettata da sola quando colleghi il database dal
# marketplace: Neon usa DATABASE_URL, Supabase e Vercel Postgres POSTGRES_URL.
# Il codice accetta entrambe.
DATABASE_URL=

# Password condivisa con le famiglie per accedere alla pagina.
TDB_PASSWORD=

# Password della pagina di gestione /terra-dei-bambini/admin (solo tua).
TDB_ADMIN_PASSWORD=

# Facoltativa: chiave di firma dei cookie di sessione. Se non impostata viene
# derivata dalle password (cambiare password invalida le sessioni aperte).
TDB_SESSION_SECRET=
